#!/usr/bin/env sh
# post-commit: parse the AI-Task / AI-Verdict trailers on the just-made
# commit, log commits missing the AI-Task trailer to ai_coding/UNROUTED.log,
# and fire a desktop notification. Writes nothing into the task folder.
#
# Constraints:
#   * POSIX-sh safe (Git for Windows MSYS bash).
#   * Non-blocking: must return immediately, must never fail a commit.
#   * Notifications are fire-and-forget; missing python is logged, not fatal.

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
AI_DIR="$REPO_ROOT/ai_coding"
UNROUTED_LOG="$AI_DIR/UNROUTED.log"
mkdir -p "$AI_DIR" 2>/dev/null || true

SHA="$(git rev-parse HEAD 2>/dev/null)"
SHORT="$(git rev-parse --short HEAD 2>/dev/null)"
MSG="$(git log -1 --format=%B 2>/dev/null)"
TS="$(date -u +%Y%m%dT%H%M%SZ)"

TASK="$(printf '%s\n' "$MSG" | grep -E '^AI-Task:' | head -1 \
        | sed 's/^AI-Task:[[:space:]]*//' | tr -d '\r')"
VERDICT="$(printf '%s\n' "$MSG" | grep -E '^AI-Verdict:' | head -1 \
        | sed 's/^AI-Verdict:[[:space:]]*//' | tr -d '\r')"

find_python() {
  for cand in \
      "$REPO_ROOT/.venv/Scripts/python.exe" \
      "$REPO_ROOT/.venv/bin/python" \
      "python" "py" "python3"; do
    if command -v "$cand" >/dev/null 2>&1 || [ -x "$cand" ]; then
      printf '%s' "$cand"
      return 0
    fi
  done
  return 1
}

fire_notify() {
  # $1=title $2=message $3=urgent(0|1)
  PY="$(find_python || true)"
  if [ -z "$PY" ]; then
    printf '[%s] notify skipped (no python found): %s: %s\n' \
      "$TS" "$1" "$2" >> "$AI_DIR/notify.log" 2>/dev/null || true
    return 0
  fi
  ( "$PY" "$AI_DIR/notify.py" "$1" "$2" "$3" \
      >/dev/null 2>>"$AI_DIR/notify.log" & ) >/dev/null 2>&1
}

if [ -z "$TASK" ]; then
  printf '[%s] %s missing AI-Task trailer\n' "$TS" "$SHA" >> "$UNROUTED_LOG"
  fire_notify "Commit not routed" "Missing AI-Task trailer on $SHORT" 1
  exit 0
fi

case "$VERDICT" in
  PASS|OVERRIDE|"")
    fire_notify "Commit recorded: $TASK" "$SHORT (${VERDICT:-no-verdict})" 0 ;;
  *)
    fire_notify "Commit recorded (unknown verdict)" \
      "Task '$TASK' commit $SHORT verdict='$VERDICT'" 1 ;;
esac

exit 0
