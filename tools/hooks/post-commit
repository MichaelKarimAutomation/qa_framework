#!/usr/bin/env sh
# post-commit — route the just-committed diff using the AI-Task trailer.
#
# Migrated from .git/hooks/post-commit into version control. While moving,
# fixed routing bug B: the original unconditionally re-created
# ai_coding/active/<task>/ even when the task folder had already been moved
# to ai_coding/archive/<task>/, leaving an empty active stub on every
# close-out commit (e.g. cbacfc2 on chore/archive-commit-msg-trailer-hook).
#
# Tri-branch routing (replaces the buggy unconditional mkdir):
#   1. ai_coding/active/<task>/  exists → route there.
#   2. ai_coding/archive/<task>/ exists → route there.
#   3. Neither → fall back to creating ai_coding/active/<task>/.
# The hook's stated purpose is to follow the task folder wherever it
# currently lives, NOT to pin every routed diff to active/.
#
# Constraints:
#   * POSIX-sh safe (Git for Windows MSYS bash).
#   * Non-blocking: must return immediately, must never fail a commit.
#   * Notifications are fire-and-forget; missing python is logged, not fatal.

set -u

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
AI_DIR="$REPO_ROOT/ai_coding"
ACTIVE_DIR="$AI_DIR/active"
ARCHIVE_DIR="$AI_DIR/archive"
UNROUTED_LOG="$AI_DIR/UNROUTED.log"
mkdir -p "$AI_DIR" 2>/dev/null || true

SHA="$(git rev-parse HEAD 2>/dev/null)"
SHORT="$(git rev-parse --short HEAD 2>/dev/null)"
MSG="$(git log -1 --format=%B 2>/dev/null)"
TS="$(date -u +%Y%m%dT%H%M%SZ)"

TASK="$(printf '%s\n' "$MSG" | grep -E '^AI-Task:' | head -1 \
        | sed 's/^AI-Task:[[:space:]]*//' | tr -d '\r')"
VERDICT="$(printf '%s\n' "$MSG" | grep -E '^AI-Verdict:' | head -1 \
        | sed 's/^AI-Verdict:[[:space:]]*//' | tr -d '\r')"

find_python() {
  for cand in \
      "$REPO_ROOT/.venv/Scripts/python.exe" \
      "$REPO_ROOT/.venv/bin/python" \
      "python" "py" "python3"; do
    if command -v "$cand" >/dev/null 2>&1 || [ -x "$cand" ]; then
      printf '%s' "$cand"
      return 0
    fi
  done
  return 1
}

fire_notify() {
  # $1=title $2=message $3=urgent(0|1)
  PY="$(find_python || true)"
  if [ -z "$PY" ]; then
    printf '[%s] notify skipped (no python found): %s: %s\n' \
      "$TS" "$1" "$2" >> "$AI_DIR/notify.log" 2>/dev/null || true
    return 0
  fi
  ( "$PY" "$AI_DIR/notify.py" "$1" "$2" "$3" \
      >/dev/null 2>>"$AI_DIR/notify.log" & ) >/dev/null 2>&1
}

if [ -z "$TASK" ]; then
  printf '[%s] %s missing AI-Task trailer\n' "$TS" "$SHA" >> "$UNROUTED_LOG"
  fire_notify "Commit not routed" "Missing AI-Task trailer on $SHORT" 1
  exit 0
fi

# --- Tri-branch routing (fix B). ---------------------------------------------
if [ -d "$ACTIVE_DIR/$TASK" ]; then
  TASK_DIR="$ACTIVE_DIR/$TASK"
elif [ -d "$ARCHIVE_DIR/$TASK" ]; then
  TASK_DIR="$ARCHIVE_DIR/$TASK"
else
  TASK_DIR="$ACTIVE_DIR/$TASK"
  mkdir -p "$TASK_DIR" 2>/dev/null || true
fi

DIFF_FILE="$TASK_DIR/diff_${TS}_${SHORT}.patch"

EMPTY_TREE="$(git hash-object -t tree /dev/null 2>/dev/null \
              || printf '4b825dc642cb6eb9a060e54bf8d69288fbee4904')"
if git rev-parse --verify -q HEAD~1 >/dev/null 2>&1; then
  git diff HEAD~1 HEAD > "$DIFF_FILE" 2>/dev/null \
    || printf '[%s] git diff failed for %s\n' "$TS" "$SHA" \
         >> "$AI_DIR/notify.log"
else
  git diff "$EMPTY_TREE" HEAD > "$DIFF_FILE" 2>/dev/null \
    || printf '[%s] first-commit diff failed for %s\n' "$TS" "$SHA" \
         >> "$AI_DIR/notify.log"
fi

case "$VERDICT" in
  PASS|OVERRIDE|"")
    fire_notify "Commit routed: $TASK" "$SHORT (${VERDICT:-no-verdict})" 0 ;;
  *)
    fire_notify "Commit routed (unknown verdict)" \
      "Task '$TASK' commit $SHORT verdict='$VERDICT'" 1 ;;
esac

exit 0
