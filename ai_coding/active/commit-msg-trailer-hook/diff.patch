+#!/usr/bin/env sh
+# commit-msg — enforce CLAUDE.md §7 trailers on every local commit.
+#
+# Rejects commits whose message is missing AI-Verdict: / AI-Task: trailers,
+# or whose AI-Verdict is malformed. Mirrors the CI merge gate in
+# .github/workflows/tests.yml so trailer-omission is caught at `git commit`
+# instead of at PR-merge.
+#
+# Constraints:
+#   * POSIX-sh safe (Git for Windows MSYS bash).
+#   * Skip non-pipeline commits (merges, amends from tooling, fixups) only
+#     when git itself supplies the special-source indicator — never skip
+#     based on branch name alone.
+#   * Exit 0 to accept, non-zero to reject.
+
+set -u
+
+MSG_FILE="$1"
+[ -n "${MSG_FILE:-}" ] && [ -f "$MSG_FILE" ] || exit 0
+
+# git passes a source as $2 for some commit types: "merge", "squash",
+# "commit" (-c/-C/--amend), "template", "message". Skip merge commits —
+# they don't represent pipeline work and shouldn't be gated.
+SRC="${2:-}"
+if [ "$SRC" = "merge" ]; then
+  exit 0
+fi
+
+MSG="$(cat "$MSG_FILE")"
+
+TASK="$(printf '%s\n' "$MSG" | grep -E '^AI-Task:' | head -1 \
+        | sed 's/^AI-Task:[[:space:]]*//' | tr -d '\r')"
+VERDICT="$(printf '%s\n' "$MSG" | grep -E '^AI-Verdict:' | head -1 \
+        | sed 's/^AI-Verdict:[[:space:]]*//' | tr -d '\r')"
+
+FAIL=0
+ERR=""
+
+if [ -z "$TASK" ]; then
+  ERR="${ERR}  - Missing 'AI-Task: <task>' trailer.
+"
+  FAIL=1
+fi
+
+if [ -z "$VERDICT" ]; then
+  ERR="${ERR}  - Missing 'AI-Verdict: PASS|CAP_REACHED|OVERRIDE' trailer.
+"
+  FAIL=1
+else
+  case "$VERDICT" in
+    PASS|CAP_REACHED|OVERRIDE) : ;;
+    *)
+      ERR="${ERR}  - Malformed 'AI-Verdict: $VERDICT' (must be PASS, CAP_REACHED, or OVERRIDE).
+"
+      FAIL=1
+      ;;
+  esac
+fi
+
+if [ "$FAIL" -ne 0 ]; then
+  printf 'commit rejected by .git/hooks/commit-msg (CLAUDE.md §7):\n%s\n' "$ERR" >&2
+  printf 'Required trailers at the end of the commit message:\n' >&2
+  printf '  AI-Verdict: PASS | CAP_REACHED | OVERRIDE\n' >&2
+  printf '  AI-Task: <task>\n' >&2
+  exit 1
+fi
+
+exit 0

